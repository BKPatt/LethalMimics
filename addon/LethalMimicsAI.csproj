<Project Sdk="Microsoft.NET.Sdk">

  <!-- LethalMimics AI: optional host-side add-on (voice cloning + LLM via a local Python server). Not on Thunderstore. -->
  <Import Project="..\Game.props" />

  <PropertyGroup>
    <AssemblyName>LethalMimicsAI</AssemblyName>
    <RootNamespace>LethalMimics.AI</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" HintPath="$(ManagedDir)\System.Net.Http.dll" />
    <ProjectReference Include="..\LethalMimics.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ai_server/**;bin/**;obj/**" />
    <None Remove="ai_server/**" />
  </ItemGroup>

  <!-- Opt-in: dotnet build -p:Deploy=true copies the add-on into the mod-manager profile for testing. -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(Deploy)' == 'true' And '$(ProfileDir)' != ''">
    <MakeDir Directories="$(ProfileDir)\BepInEx\plugins\LethalMimicsAI\ai_server" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProfileDir)\BepInEx\plugins\LethalMimicsAI" />
    <Copy SourceFiles="ai_server\server.py;ai_server\requirements.txt;ai_server\setup.ps1" DestinationFolder="$(ProfileDir)\BepInEx\plugins\LethalMimicsAI\ai_server" />
  </Target>

</Project>
