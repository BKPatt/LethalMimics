<Project>
  <!-- Copy to LethalAudio.local.props and edit for your machine. -->
  <PropertyGroup>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Lethal Company</GameDir>
    <!-- A Thunderstore/r2modman profile that has BepInEx installed. -->
    <ProfileDir>$(APPDATA)\r2modmanPlus-local\LethalCompany\profiles\Default</ProfileDir>
  </PropertyGroup>
</Project>
