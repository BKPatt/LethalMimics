<Project>
  <!-- Shared by LethalMimics.csproj and addon/LethalMimicsAI.csproj.
       Machine-specific paths (GameDir / ProfileDir) go in LethalMimics.local.props; see LethalMimics.local.props.example. -->
  <Import Project="$(MSBuildThisFileDirectory)LethalMimics.local.props" Condition="Exists('$(MSBuildThisFileDirectory)LethalMimics.local.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- GameDir: the Lethal Company install. ProfileDir: a mod-manager profile with BepInEx (optional; without it
         BepInEx is taken from the game folder). Set them in LethalMimics.local.props or with -p:GameDir=... -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Lethal Company</GameDir>
    <ManagedDir>$(GameDir)\Lethal Company_Data\Managed</ManagedDir>
    <BepInExCore Condition="'$(ProfileDir)' != ''">$(ProfileDir)\BepInEx\core</BepInExCore>
    <BepInExCore Condition="'$(ProfileDir)' == ''">$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)\BepInEx.dll" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)\0Harmony.dll" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)\Assembly-CSharp.dll" />
    <Reference Include="Unity.Netcode.Runtime" HintPath="$(ManagedDir)\Unity.Netcode.Runtime.dll" />
    <Reference Include="Unity.InputSystem" HintPath="$(ManagedDir)\Unity.InputSystem.dll" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="Newtonsoft.Json" HintPath="$(ManagedDir)\Newtonsoft.Json.dll" />
  </ItemGroup>
</Project>
